[sub_resource type="GDScript" id="GDScript_l8cum"]
resource_name = "LoopingMovement"
script/source = "extends PathFollow2D

var target = 0.98

@export var speed: float = 0.7

func _process(delta: float) -> void:
	if speed > 0:
		_loop_movement(delta)

func _loop_movement(delta:float) -> void:
	if progress_ratio < target:
		progress_ratio += delta * (speed)
		target = 0.98
	elif progress_ratio > target:
		progress_ratio += delta * (-speed)
		target = 0.02

func set_speed(new_speed: float) -> void:
	if speed > 0.2:
		speed -= new_speed
"

