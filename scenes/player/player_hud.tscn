[sub_resource type="GDScript" id="GDScript_h6f0n"]
resource_name = "SkillTreeStartup"
script/source = "extends GridContainer

@onready var children = get_children()

var has_started: bool = false

func _unhandled_input(event: InputEvent) -> void:
	if event.is_action_pressed(\"journal\") and !has_started:
		has_started = true
		for child in children:
			if child.has_method(\"startup\"):
				child.startup()
"

